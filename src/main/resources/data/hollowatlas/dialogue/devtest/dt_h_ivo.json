  "nodes": {
    "asleep": {
      "text": "(Asleep. This is the sleeping-resident test response.)",
      "speaker": "narrator"
    },
    "main": {
      "text": "Test Heights. Steep roads, rope bridge, terraces, a mine, a lookout and a summit. All of it is a test.",
      "choices": [
        {
          "text": "Start: Summit Climb",
          "go": "end",
          "tag": "quest",
          "when": {
            "quest_not_started": "dtq_climb"
          },
          "actions": [
            {
              "quest": "dtq_climb",
              "type": "start_quest"
            }
          ]
        },
        {
          "text": "What should I test here?",
          "go": "tips",
          "tag": "ask"
        },
        {
          "text": "Goodbye.",
          "go": "end",
          "tag": "leave"
        }
      ],
      "variants": [
        {
          "when": {
            "weather": "rain"
          },
          "text": "Rain on the mountain. Roads are still walkable; tell me if they aren't."
        }
      ]
    },
    "tips": {
      "text": "Walk every ramp without jumping. Cross the rope bridge. Follow a resident up the terraces. Watch the waterfalls. Climb to the top.",
      "choices": [
        {
          "text": "Back.",
          "go": "main"
        },
        {
          "text": "Goodbye.",
          "go": "end",
          "tag": "leave"
        }
      ]
    }
  }
}